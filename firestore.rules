rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // User profiles: strictly owner read/write
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('email' in request.resource.data) || request.resource.data.email is string);
      allow delete: if isOwner(userId);
    }

    // Chat threads: strictly owned by the author user
    match /chat_threads/{threadId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(threadId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // User project memory and snapshots
    match /user_projects/{projectId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256
        && (!('userId' in request.resource.data) || request.resource.data.userId == null || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User custom MythoriaLib templates: strictly owned by the author user
    match /custom_templates/{templateId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(templateId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 128
        && request.resource.data.kind in ['thumbnail', 'image', 'video']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['thumbnail', 'image', 'video']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Encrypted user provider API keys (Groq / OpenAI): strictly owner-isolated
    match /user_provider_keys/{keyDocId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && keyDocId is string
        && keyDocId.size() > 0
        && keyDocId.size() <= 160
        && request.resource.data.keys().hasAll(['id', 'userId', 'provider', 'encryptedKey', 'iv', 'authTag', 'maskedKey'])
        && request.resource.data.keys().hasOnly(['id', 'userId', 'provider', 'encryptedKey', 'iv', 'authTag', 'maskedKey', 'model', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == keyDocId
        && request.resource.data.provider in ['groq', 'openai']
        && request.resource.data.encryptedKey is string
        && request.resource.data.encryptedKey.size() > 0
        && request.resource.data.encryptedKey.size() <= 2048
        && request.resource.data.iv is string
        && request.resource.data.iv.size() > 0
        && request.resource.data.iv.size() <= 128
        && request.resource.data.authTag is string
        && request.resource.data.authTag.size() > 0
        && request.resource.data.authTag.size() <= 128
        && request.resource.data.maskedKey is string
        && request.resource.data.maskedKey.size() <= 64
        && (!('model' in request.resource.data) || (request.resource.data.model is string && request.resource.data.model.size() <= 128));
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.keys().hasAll(['id', 'userId', 'provider', 'encryptedKey', 'iv', 'authTag', 'maskedKey'])
        && request.resource.data.keys().hasOnly(['id', 'userId', 'provider', 'encryptedKey', 'iv', 'authTag', 'maskedKey', 'model', 'createdAt', 'updatedAt'])
        && request.resource.data.encryptedKey is string
        && request.resource.data.encryptedKey.size() > 0
        && request.resource.data.encryptedKey.size() <= 2048
        && request.resource.data.iv is string
        && request.resource.data.iv.size() <= 128
        && request.resource.data.authTag is string
        && request.resource.data.authTag.size() <= 128
        && request.resource.data.maskedKey is string
        && request.resource.data.maskedKey.size() <= 64
        && (!('model' in request.resource.data) || (request.resource.data.model is string && request.resource.data.model.size() <= 128))
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Persisted AI-generated / edited image metadata: strictly owner-isolated
    match /generated_images/{imageId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(imageId)
        && request.resource.data.keys().hasAll(['id', 'userId', 'provider', 'model', 'originalPrompt', 'fileName', 'mimeType', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == imageId
        && request.resource.data.provider is string
        && request.resource.data.provider.size() <= 64
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 128
        && request.resource.data.originalPrompt is string
        && request.resource.data.originalPrompt.size() <= 4000
        && (!('optimizedPrompt' in request.resource.data) || (request.resource.data.optimizedPrompt is string && request.resource.data.optimizedPrompt.size() <= 8000))
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 256
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 64
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 64;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
