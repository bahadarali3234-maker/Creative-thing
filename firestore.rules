rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // User profiles: strictly owner read/write
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('email' in request.resource.data) || request.resource.data.email is string);
      allow delete: if isOwner(userId);
    }

    // Chat threads: strictly owned by the author user
    match /chat_threads/{threadId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(threadId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // User project memory and snapshots
    match /user_projects/{projectId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256
        && (!('userId' in request.resource.data) || request.resource.data.userId == null || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User custom MythoriaLib templates: strictly owned by the author user
    match /custom_templates/{templateId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(templateId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 128
        && request.resource.data.kind in ['thumbnail', 'image', 'video']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['thumbnail', 'image', 'video']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
