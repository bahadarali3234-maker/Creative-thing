# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROK_API_KEY / GROQ_API_KEY: Primary Grok (xAI xai-...) or Groq (gsk_...) API key.
GROK_API_KEY=""
# GROK_API_KEY_FALLBACK: Secondary Grok/Groq API key used automatically on HTTP 429 rate limits.
GROK_API_KEY_FALLBACK=""
GROQ_API_KEY=""
GROQ_API_KEY_FALLBACK=""

# OPENAI_API_KEY: Server-side OpenAI API key for real GPT Image generation & editing (gpt-image-1).
OPENAI_API_KEY=""

# API_KEY_ENCRYPTION_SECRET: Secret used to encrypt user-supplied Groq/OpenAI keys via AES-256-GCM.
API_KEY_ENCRYPTION_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Web SDK)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="facemorph-studio.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="facemorph-studio"
VITE_FIREBASE_STORAGE_BUCKET="facemorph-studio.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-ABCDEF1234"

# Optional Firebase Emulator Toggle (set to 'true' in local dev if emulators run)
VITE_USE_FIREBASE_EMULATOR="false"

# Safety & Abuse Reporting Email
VITE_SUPPORT_EMAIL="safety@facemorph.studio"

# Backend Automated Email Delivery (Gmail OAuth2 or SMTP — falls back to client OAuth if blank)
GMAIL_SENDER_USER=""
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

