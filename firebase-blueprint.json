{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "lastLoginAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "User conversation thread with Grok assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "promptBanner": { "type": "string", "maxLength": 2048 },
        "activeTab": { "type": "string", "maxLength": 64 },
        "messages": { "type": "array" },
        "messagesCount": { "type": "number" },
        "lastUpdated": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId"]
    },
    "UserProject": {
      "title": "UserProject",
      "description": "User project blueprint and memory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "lastSyncedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Consultation booking reservation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "topic": { "type": "string", "maxLength": 256 },
        "selectedDate": { "type": "string", "maxLength": 64 },
        "selectedSlot": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "selectedDate", "selectedSlot"]
    },
    "CustomTemplate": {
      "title": "CustomTemplate",
      "description": "User-saved MythoriaLib creative studio template",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "kind": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "kind", "name"]
    },
    "UserProviderKey": {
      "title": "UserProviderKey",
      "description": "Server-side AES-256-GCM encrypted user API key and provider model preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "userId": { "type": "string", "maxLength": 128 },
        "provider": { "type": "string", "maxLength": 32 },
        "encryptedKey": { "type": "string", "maxLength": 2048 },
        "iv": { "type": "string", "maxLength": 128 },
        "authTag": { "type": "string", "maxLength": 128 },
        "maskedKey": { "type": "string", "maxLength": 64 },
        "model": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "provider", "encryptedKey", "iv", "authTag", "maskedKey"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "Persisted generated or edited AI image metadata (binary image stored on disk storage)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "parentImageId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "maxLength": 32 },
        "provider": { "type": "string", "maxLength": 64 },
        "model": { "type": "string", "maxLength": 128 },
        "originalPrompt": { "type": "string", "maxLength": 4000 },
        "optimizedPrompt": { "type": "string", "maxLength": 8000 },
        "style": { "type": "string", "maxLength": 64 },
        "size": { "type": "string", "maxLength": 32 },
        "quality": { "type": "string", "maxLength": 32 },
        "outputFormat": { "type": "string", "maxLength": 16 },
        "fileName": { "type": "string", "maxLength": 256 },
        "filePath": { "type": "string", "maxLength": 512 },
        "mimeType": { "type": "string", "maxLength": 64 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "bytes": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "provider", "model", "originalPrompt", "fileName", "mimeType", "createdAt"]
    },
    "UserEmailPreference": {
      "title": "UserEmailPreference",
      "description": "User automated email schedule, routine blocks, and verified Islamic footer preference",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "frequency": { "type": "string", "maxLength": 32 },
        "dailyEmailsEnabled": { "type": "boolean" },
        "dailyRoutineEnabled": { "type": "boolean" },
        "islamicFooterEnabled": { "type": "boolean" },
        "preferredSendTime": { "type": "string", "maxLength": 16 },
        "focusGoal": { "type": "string", "maxLength": 512 },
        "welcomeEmailSentAt": { "type": "string", "maxLength": 64 },
        "lastDailySentDate": { "type": "string", "maxLength": 32 },
        "sentQuotationIds": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email", "frequency", "islamicFooterEnabled"]
    },
    "EmailDeliveryLog": {
      "title": "EmailDeliveryLog",
      "description": "Audit log of delivered welcome and scheduled emails per user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "recipientEmail": { "type": "string", "maxLength": 256 },
        "emailType": { "type": "string", "maxLength": 32 },
        "idempotencyKey": { "type": "string", "maxLength": 160 },
        "quotationId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "providerUsed": { "type": "string", "maxLength": 48 },
        "sentAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "recipientEmail", "emailType", "status", "sentAt"]
    },
    "EmailAutomationQueue": {
      "title": "EmailAutomationQueue",
      "description": "Scheduled automated email queue jobs with retry tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "emailType": { "type": "string", "maxLength": 32 },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "attempts": { "type": "number" },
        "idempotencyKey": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "emailType", "scheduledFor", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents keyed by UID"
    },
    "/chat_threads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Chat conversations authored by user"
    },
    "/user_projects/{projectId}": {
      "schema": { "$ref": "#/entities/UserProject" },
      "description": "User projects blueprints"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Consultation bookings"
    },
    "/custom_templates/{templateId}": {
      "schema": { "$ref": "#/entities/CustomTemplate" },
      "description": "User custom creative studio templates keyed by template ID"
    },
    "/user_provider_keys/{keyDocId}": {
      "schema": { "$ref": "#/entities/UserProviderKey" },
      "description": "User encrypted Groq/OpenAI API keys and preferred models"
    },
    "/generated_images/{imageId}": {
      "schema": { "$ref": "#/entities/GeneratedImage" },
      "description": "User generated and edited AI image records"
    },
    "/user_email_preferences/{userId}": {
      "schema": { "$ref": "#/entities/UserEmailPreference" },
      "description": "User email schedule, routine items, and verified Islamic footer preference keyed by UID"
    },
    "/email_delivery_logs/{logId}": {
      "schema": { "$ref": "#/entities/EmailDeliveryLog" },
      "description": "Per-user email delivery audit trail"
    },
    "/email_automation_queue/{jobId}": {
      "schema": { "$ref": "#/entities/EmailAutomationQueue" },
      "description": "Per-user scheduled email queue records"
    }
  }
}
