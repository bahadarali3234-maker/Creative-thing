{
 "conventions": [
  "Every effect code uses CSS variables defined on #canvas: --bg --surface --primary --accent --text and --u (= canvas width / 100 in px).",
  "Define --u once: #canvas{--u:12.8px} for a 1280-wide canvas.",
  "exportSafe:false means the effect needs a modern browser renderer (backdrop-filter, mix-blend-mode, background-clip:text, filters). If the app exports PNG with html2canvas/dom-to-image, prefer exportSafe:true effects or use the fallback in 'usage'.",
  "Overlay layers use position:absolute and must sit inside #canvas which has position:relative;overflow:hidden."
 ],
 "effects": [
  {
   "id": "grain",
   "name": "Film grain overlay",
   "type": "css",
   "exportSafe": false,
   "usage": "Add <div class=\"fx-grain\"></div> as the LAST child of #canvas. Raises perceived quality.",
   "code": ".fx-grain{position:absolute;inset:0;pointer-events:none;opacity:.16;mix-blend-mode:overlay;background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\")}"
  },
  {
   "id": "vignette",
   "name": "Vignette",
   "type": "css",
   "exportSafe": true,
   "usage": "Overlay above background, below text.",
   "code": ".fx-vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 55%,rgba(0,0,0,.62) 100%)}"
  },
  {
   "id": "text-stroke-shadow",
   "name": "Thick text outline (export safe)",
   "type": "css",
   "exportSafe": true,
   "usage": "Thumbnail headlines. Change #000 to a dark brand colour if needed. Works in html2canvas, unlike -webkit-text-stroke.",
   "code": ".fx-stroke{color:#fff;text-shadow:-4px -4px 0 #000,4px -4px 0 #000,-4px 4px 0 #000,4px 4px 0 #000,0 -5px 0 #000,0 5px 0 #000,-5px 0 0 #000,5px 0 0 #000,0 8px 14px rgba(0,0,0,.55)}"
  },
  {
   "id": "glow-text",
   "name": "Neon glow text",
   "type": "css",
   "exportSafe": true,
   "usage": "Use on 1-2 words only; keep text white/near-white for readability.",
   "code": ".fx-glow{color:#fff;text-shadow:0 0 .12em var(--accent),0 0 .35em var(--accent),0 0 .8em var(--primary)}"
  },
  {
   "id": "long-shadow",
   "name": "Long text shadow",
   "type": "css",
   "exportSafe": true,
   "usage": "Flat-vector / retro titles. Replace #000 with a darker tone of the background.",
   "code": ".fx-long{text-shadow:1px 1px 0 #000,2px 2px 0 #000,3px 3px 0 #000,4px 4px 0 #000,5px 5px 0 #000,6px 6px 0 #000,7px 7px 0 #000,8px 8px 0 #000,9px 9px 0 #000,10px 10px 0 #000,11px 11px 0 #000,12px 12px 0 #000}"
  },
  {
   "id": "hard-shadow",
   "name": "Hard offset shadow",
   "type": "css",
   "exportSafe": true,
   "usage": "Brutalist / comic panels.",
   "code": ".fx-hard{box-shadow:calc(var(--u)*.8) calc(var(--u)*.8) 0 #000;border:calc(var(--u)*.45) solid #000}"
  },
  {
   "id": "gold-text",
   "name": "Gold gradient text",
   "type": "css",
   "exportSafe": false,
   "usage": "Luxury titles. If export must be html2canvas use flat #e8b04b with text-shadow instead.",
   "code": ".fx-gold{background:linear-gradient(180deg,#fff3c4 0%,#e8b04b 45%,#7a5b1e 55%,#f4d27a 100%);-webkit-background-clip:text;background-clip:text;color:transparent}"
  },
  {
   "id": "gradient-text",
   "name": "Gradient text",
   "type": "css",
   "exportSafe": false,
   "usage": "One keyword only.",
   "code": ".fx-gradtext{background:linear-gradient(90deg,var(--primary),var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent}"
  },
  {
   "id": "glitch-text",
   "name": "Glitch RGB split",
   "type": "css",
   "exportSafe": true,
   "usage": "Cyberpunk titles.",
   "code": ".fx-glitch{text-shadow:.04em 0 #ff2bd6,-.04em 0 #00f0ff}"
  },
  {
   "id": "glass-card",
   "name": "Glass card",
   "type": "css",
   "exportSafe": false,
   "usage": "Needs something colourful behind it. Fallback for non-supporting renderers: background rgba(255,255,255,.22).",
   "code": ".fx-glass{background:rgba(255,255,255,.14);backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);border:1px solid rgba(255,255,255,.3);border-radius:calc(var(--u)*2.4);box-shadow:0 calc(var(--u)*1.6) calc(var(--u)*5) rgba(0,0,0,.3)}"
  },
  {
   "id": "neumorph-raised",
   "name": "Neumorphic raised",
   "type": "css",
   "exportSafe": true,
   "usage": "Background must be mid-light tone (#e6ebf2 style).",
   "code": ".fx-neu{background:var(--bg);border-radius:calc(var(--u)*3);box-shadow:calc(var(--u)*1) calc(var(--u)*1) calc(var(--u)*2.4) rgba(0,0,0,.18),calc(var(--u)*-1) calc(var(--u)*-1) calc(var(--u)*2.4) rgba(255,255,255,.9)}"
  },
  {
   "id": "neumorph-pressed",
   "name": "Neumorphic pressed",
   "type": "css",
   "exportSafe": true,
   "usage": "Inputs / pressed buttons.",
   "code": ".fx-neu-in{background:var(--bg);border-radius:calc(var(--u)*3);box-shadow:inset calc(var(--u)*.8) calc(var(--u)*.8) calc(var(--u)*2) rgba(0,0,0,.18),inset calc(var(--u)*-.8) calc(var(--u)*-.8) calc(var(--u)*2) rgba(255,255,255,.9)}"
  },
  {
   "id": "mesh-gradient",
   "name": "Mesh gradient background",
   "type": "css",
   "exportSafe": true,
   "usage": "Full-canvas background layer.",
   "code": ".fx-mesh{background:radial-gradient(at 12% 18%,var(--primary) 0,transparent 55%),radial-gradient(at 85% 12%,var(--accent) 0,transparent 50%),radial-gradient(at 75% 88%,var(--primary) 0,transparent 55%),radial-gradient(at 8% 85%,var(--accent) 0,transparent 50%),var(--bg)}"
  },
  {
   "id": "sunburst",
   "name": "Sunburst rays",
